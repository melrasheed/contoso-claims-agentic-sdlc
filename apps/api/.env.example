# Contoso Claims API - local development settings
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Fault-injection admin endpoints. Deliberately enabled in dev so the
# incident-detection demo can trigger latency/error/memory faults on demand.
ADMIN_ENABLED=true

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Leave empty to run without telemetry; set to enable Azure Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=
