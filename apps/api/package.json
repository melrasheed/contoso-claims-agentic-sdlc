{
  "name": "@contoso/claims-api",
  "version": "1.0.0",
  "private": true,
  "description": "Contoso Claims REST API - Express 4 + TypeScript reference service for the Agentic SDLC accelerator",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "prebuild": "tsc -b ../../packages/shared",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "tsc -b ../../packages/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@contoso/shared": "1.0.0",
    "applicationinsights": "^3.4.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
