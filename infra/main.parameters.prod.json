{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "value": "contoso"
    },
    "environmentName": {
      "value": "prod"
    },
    "sku": {
      "value": "S1"
    },
    "enableSlots": {
      "value": true
    },
    "adminEnabled": {
      "value": false
    },
    "alertEmailAddress": {
      "value": "ops-team@example.com"
    },
    "http5xxThreshold": {
      "value": 3
    },
    "responseTimeThresholdSeconds": {
      "value": 2
    },
    "alertsEnabled": {
      "value": true
    },
    "viteApiBaseUrl": {
      "value": "https://contoso-api-prod.azurewebsites.net"
    }
  }
}
